{
  "name": "@ytriple/source-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime-validated HTTP contract for the ytriple source service",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
