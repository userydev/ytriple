{
  "name": "ytriple",
  "version": "0.1.1",
  "private": true,
  "description": "AI team workbench for desktop and self-hosted services",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run check:boundaries && npm test && npm run build",
    "test:ui": "playwright test",
    "test:live": "tsx scripts/live-smoke.ts",
    "package": "npm run build && node scripts/package.mjs",
    "server": "tsx src/server/index.ts",
    "server:build": "node scripts/build-server.mjs",
    "test:container": "node scripts/container-smoke.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.2.11",
    "@langchain/google": "^0.2.6",
    "@langchain/langgraph": "1.4.15",
    "@langchain/openai": "1.5.13",
    "fastify": "^5.12.4",
    "langsmith": "^0.10.3",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.18"
  }
}
