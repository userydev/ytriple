# yTriple provider credentials.
#
# Keys are never stored in config files or shipped to a renderer process. The CLI
# harness reads them from the environment through a SecretsPort; the desktop app
# resolves the same secret refs from the OS keychain.
#
# Each provider config references a key by name, e.g. { "apiKeyRef": "ARK_API_KEY" }.

# Volcengine Ark (Responses API, native web_search)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6-250615

# Google Gemini (native search grounding)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# DeepSeek (OpenAI compatible, JSON object mode)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Any OpenAI-compatible endpoint (OpenRouter, Ollama, vLLM, ...)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_MODEL=

# Optional standalone web search fallback for providers without native search
SEARCH_API_KEY=
